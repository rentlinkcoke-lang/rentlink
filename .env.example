# ---- RentLink environment (copy to .env and fill in) ----

# Database. Local dev uses SQLite; production uses Postgres (Neon) — see DEPLOY.md.
DATABASE_URL="file:./dev.db"
# DIRECT_URL is only needed on Postgres (Neon) for migrations:
# DATABASE_URL="postgresql://USER:PASS@HOST/db?sslmode=require&pgbouncer=true"
# DIRECT_URL="postgresql://USER:PASS@HOST/db?sslmode=require"

# Auth (jose JWT). Generate a long random string in production.
AUTH_SECRET=""

# Encrypts landlords' Daraja credentials at rest. Long random string; keep secret.
RENTLINK_ENC_KEY=""

# Public base URL (Safaricom/Meta callbacks must reach it). Your deployed URL in prod.
APP_BASE_URL="http://localhost:3000"

# Shared secret guarding the cron endpoints (invoices/reminders/billing schedulers).
CRON_SECRET=""

# ---- Onfon Media SMS (Dashboard > Settings > API SETTINGS) ----
ONFON_API_KEY=""
ONFON_CLIENT_ID=""
ONFON_ACCESS_KEY=""
ONFON_SENDER_ID=""

# ---- Resend email (verify the rentlink.co.ke domain first) ----
RESEND_API_KEY=""
EMAIL_FROM="RentLink <receipts@rentlink.co.ke>"

# ---- WhatsApp Cloud API (Meta) — see WHATSAPP_SETUP.md ----
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_LANG="en"
WHATSAPP_TEMPLATE_RECEIPT="rent_receipt"
WHATSAPP_TEMPLATE_INVOICE="rent_invoice"
WHATSAPP_TEMPLATE_REMINDER="rent_reminder"
WHATSAPP_VERIFY_TOKEN=""

# ---- RentLink's OWN M-Pesa paybill (subscription billing collection) ----
PLATFORM_MPESA_SHORTCODE=""
PLATFORM_DARAJA_CONSUMER_KEY=""
PLATFORM_DARAJA_CONSUMER_SECRET=""
PLATFORM_DARAJA_PASSKEY=""
PLATFORM_DARAJA_ENV="sandbox"
